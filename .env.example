# DiagnoseIt settings. Copy to .env on each self-hosted server.
# Everything is optional for a local self-hosted install: `docker compose up -d` works without this file.

# --- Access ---
# Web port, and the address it listens on. 127.0.0.1 = this machine only; 0.0.0.0 = your network too.
# DIAGNOSEIT_PORT=3000
# DIAGNOSEIT_BIND=127.0.0.1
# Host names the app answers to, comma-separated. Add your server's name or IP when not using localhost.
# ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Existing production installs: keep the volume names used by the old production override.
# DIAGNOSEIT_DB_VOLUME=diagnoseit_postgres_data
# DIAGNOSEIT_MEDIA_VOLUME=diagnoseit_media_data
# DIAGNOSEIT_STATIC_VOLUME=diagnoseit_static_data
# Origins allowed to submit the Django admin login form, e.g. https://health.example.com
# CSRF_TRUSTED_ORIGINS=

# --- Accounts ---
# The first account created becomes the administrator. After that only an administrator adds accounts
# (in /admin), unless this is set, which lets anyone who can reach the server sign up.
# REGISTRATION_OPEN=False

# --- First administrator (created on first start if both are set) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# --- Secrets ---
# Leave SECRET_KEY unset to have one generated and kept in the app_data volume.
# SECRET_KEY=
# Database password. Set it before the first start; changing it later needs a database password change too.
# POSTGRES_PASSWORD=

# API tokens expire after this many days.
# API_TOKEN_TTL_DAYS=30

# --- HTTPS (behind a TLS reverse proxy that sets X-Forwarded-Proto) ---
# SECURE_SSL_REDIRECT=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# Browser CORS, only needed when the web app is served from another origin.
# CORS_ALLOWED_ORIGINS=

# --- AI (optional; administrators can also configure these in the app under Settings -> AI) ---
# Chat model for diagnosis, report chat, and prescription reading. Any OpenAI-compatible API.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1000

# --- OCR for scanned PDFs (optional) ---
# Ollama: `docker compose --profile ollama up -d` runs one at http://ollama:11434.
# VLM_PROVIDER=ollama
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=qwen3-vl:4b
# Or an OpenAI-compatible vision server:
# VLM_PROVIDER=openai
# VLM_API_BASE=http://host.docker.internal:8080/v1
# VLM_MODEL=PaddleOCR-VL-1.6 (Vision OCR)
# VLM_MODE=paddle_ocr
# VLM_TIMEOUT=180
# USE_VLM_PARSER=true

# --- Custom report formats (see report_formats/README.md) ---
# Folder of format files inside the container, and extra format modules installed as packages.
# REPORT_FORMATS_DIR=/app/report_formats
# REPORT_FORMATS=acme_formats.cbc
